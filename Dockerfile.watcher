FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    TZ=Europe/Berlin

WORKDIR /app

COPY cloud_watcher/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && mkdir -p /data \
    && chown 10001:10001 /data

COPY scan_core.py ./
COPY shop_config.json ./
COPY cloud_watcher ./cloud_watcher
COPY tools/watcher_report.py ./tools/watcher_report.py

USER 10001:10001
VOLUME ["/data"]

# Ein haengender Loop schreibt keine frische Wachzeit mehr. 180 s Toleranz
# liegen deutlich ueber dem Schreibabstand von 15 s.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import json, os, time; p = os.path.join(os.environ.get('WATCH_DATA_DIR', '/data'), 'watcher_status.json'); d = json.load(open(p, encoding='utf-8')); raise SystemExit(0 if time.time() - float(d.get('wach_ts') or 0) <= 180 else 1)"

CMD ["python", "-m", "cloud_watcher.watcher"]
