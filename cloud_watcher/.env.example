# Cloud-Waechter: nur die Webhook-URLs sind geheim.
# ntfy:     https://ntfy.sh/<geheimer-topic>
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>
# Discord:  https://discord.com/api/webhooks/<ID>/<TOKEN>
WATCH_WEBHOOK_URL=
# Leer = automatisch aus der URL erkennen (ntfy/telegram/discord/generisch).
WATCH_WEBHOOK_PRESET=
# Optional: unabhaengiger Ops-Kanal nur fuer den Systemalarm ("Alarm nicht
# zugestellt"). Bleibt er leer, nutzt der Systemalarm den normalen Webhook oben.
# Auch diese URL ist geheim und wird nie geloggt.
WATCH_OPS_WEBHOOK_URL=

# Schattenbetrieb: 1 = nur protokollieren, 0 = nach Ablauf der Frist senden.
WATCH_SHADOW=1
WATCH_SHADOW_HOURS=48

# Zwei Shops. Namen muessen exakt den Haendlern in scan_core entsprechen.
WATCH_SHOPS=PS Direct DE,PS Direct AT

# Im Auflegefenster 09:00-18:00 Ortszeit; ausserhalb ruhiger.
WATCH_WINDOW_TAKT=45
WATCH_TAKT_AUSSEN=180
WATCH_TZ=Europe/Berlin

# Preisdeckel in Euro. AT erbt den DE-Wert.
WATCH_MAX_PREIS=900
# Neupreis-Alarm erst ab dieser Preissenkung in Euro (Rauschen vermeiden).
WATCH_PREIS_TOLERANZ=1
# Globales Request-Budget pro Minute; PS Direct wird zuerst bedient.
WATCH_MAX_REQ_MIN=12

# Im Container /data; lokal z. B. ./cloud_watcher/data.
WATCH_DATA_DIR=/data

# Optional, fuer den Schattenlauf empfohlen: Lebenszeichen alle 60 s,
# unabhaengig von faelligen Shops (z. B. healthchecks.io). Auch diese URL ist
# geheim und wird nie geloggt.
WATCH_HEARTBEAT_URL=
